{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rubrica",
  "version": "1.0.0",
  "identifier": "com.rubrica.desktop",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Rúbrica — Suite de Gestión y Firma Documental",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rubrica Technologies",
    "copyright": "Copyright 2026 Rubrica. Todos los derechos reservados.",
    "shortDescription": "Suite de Gestión Documental y Firma Electrónica",
    "longDescription": "Suite ligera de taller PDF nativo y firma electrónica remota con certificación legal NOM-151.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.rubrica.com.mx/updates/{{target}}/{{current_version}}"
      ]
    }
  }
}
